    {
      "id": "QpVBWx3uHTjzR5cznuH8m",
      "type": "text",
      "x": 451,
      "y": 118.2,
      "width": 224,
      "height": 73.6,
      "angle": 0,
      "strokeColor": "#FFFFFF",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 382102359,
      "version": 3,
      "versionNonce": 2113468183,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792643480979,
      "link": null,
      "locked": false,
      "text": "写 strategy.json，逐项复述\n（含默认值；无止损、无防夹、\n和手动交易共用额度）\n先不启动",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r-164",
      "originalText": "写 strategy.json，逐项复述\n（含默认值；无止损、无防夹、\n和手动交易共用额度）\n先不启动",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {

    {
      "id": "t-193",
      "type": "text",
      "x": 18,
      "y": 1080,
      "width": 857.31298828125,
      "height": 76.5,
      "angle": 0,
      "strokeColor": "#FFFFFF",
      "backgroundColor": "transparent",

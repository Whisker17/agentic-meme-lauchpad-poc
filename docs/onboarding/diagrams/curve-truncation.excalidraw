    {
      "id": "t-87",
      "type": "text",
      "x": 928,
      "y": 112,
      "width": 352.22705078125,
      "height": 221.85,
      "angle": 0,
      "strokeColor": "#B8C6BE",
      "backgroundColor": "transparent",

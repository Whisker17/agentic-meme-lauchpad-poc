      "link": null,
      "locked": false,
      "text": "spender 必须是受信的 Launchpad，\n5 mUSD 不能超过剩余额度。",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "spender 必须是受信的 Launchpad，\n5 mUSD 不能超过剩余额度。",
      "autoResize": true,
      "lineHeight": 1.45
    },
    {
